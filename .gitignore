# Dados - bronze/silver/gold: manifests (CSV/JSON) sao pequenos e versionados;
# os artefatos grandes/derivados (landmarks por video, janelas de treino) NAO sao.
# **/*.npz (nao so *.npz) porque as janelas ficam em data/gold/{train,val,test}/windows.npz,
# um nivel mais fundo que data/gold/ direto - um glob raso deixava esses arquivos passarem.
data/silver/landmarks/
data/gold/**/*.npz
data/gold/**/*.npy

# Custom (Dia 3, teste de domain gap): mesma logica do silver - landmarks
# derivados nao sao versionados, so o manifest.csv (pequeno) fica.
data/custom/landmarks/

# Modelos - checkpoints de treino sao intermediarios, nao versionados.
# O artefato final (.tflite + classes.json + MODEL_CARD.md) em models/artifacts/ FICA versionado.
models/checkpoints/
*.h5

# Bundle do MediaPipe (binario baixado, nao gerado por nos)
models/mediapipe/

